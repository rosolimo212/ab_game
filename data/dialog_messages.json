    },
    {
      "id": 7,
      "name": "next_round",
      "when": "FEEDBACK → далее",
      "default": "Далее",
      "console": "",
      "telegram": "",
      "browser": ""
    },
    {
      "id": 8,
      "name": "end_game",
      "when": "Досрочно завершить",
      "default": "Закончить игру",
      "console": "",
      "telegram": "",
