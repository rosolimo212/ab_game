[Unit]
Description=ab_game Streamlit (ab.kotelok.space)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/python/ab_game
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/python/ab_game/.venv/bin/streamlit run ui/streamlit_app.py \
  --server.address=127.0.0.1 \
  --server.port=8503 \
  --server.headless=true \
  --browser.gatherUsageStats=false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
